# Staging worksheet. Copy to .env.staging for your private notes. Set runtime
# values in the Render service's Environment settings; use the direct database
# URL only from a trusted migration/release environment. Render does not load
# this file from the repository. Never commit filled credentials.

# Pin the Render build to Node 22; package.json currently allows newer majors.
NODE_VERSION=22
NODE_ENV=production

# Use the POOLED Neon URL for normal API traffic (-pooler in the hostname).
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@ep-staging-pooler.region.aws.neon.tech/STAGING_DB?sslmode=require
# Use the DIRECT URL only for migrations and trusted release tasks. The current
# render.yaml still declares it; review that before deploying the web service.
DATABASE_URL_UNPOOLED=postgresql://STAGING_USER:STAGING_PASSWORD@ep-staging.region.aws.neon.tech/STAGING_DB?sslmode=require

# The exact Vercel staging origin, without a trailing slash, and its bare host.
# Add additional exact origins/hosts with commas; never use * for staging.
ALLOWED_ORIGINS=https://your-staging-site.vercel.app
ALLOWED_FORWARDED_HOSTS=your-staging-site.vercel.app
TRUST_PROXY_HEADERS=true
# Fill only with verified ingress proxy IPs/CIDRs. Empty uses socket-peer quotas.
AUTH_TRUSTED_PROXY_CIDRS=
# RENDER_EXTERNAL_HOSTNAME is provided automatically by Render.

ALLOW_REGISTRATION=false
# Optional root recovery secret, 20–256 characters. Configure privately on Render.
# ROOT_FALLBACK_PASSWORD=
SESSION_COOKIE_NAME=plg_session
SESSION_MAX_AGE_SECONDS=604800

# One-time bootstrap on the staging database: set BOOTSTRAP_EMAIL and
# BOOTSTRAP_NAME in a trusted terminal, and supply the password via stdin.
# Do not keep BOOTSTRAP_PASSWORD in Render's web-service environment.
# BOOTSTRAP_EMAIL=parent@example.com
# BOOTSTRAP_NAME=Staging Parent

# Optional: configure ALL five S3 values together if testing private media.
# Leave them all unset otherwise; private /media/* reads will return 503.
# S3_ENDPOINT=https://your-staging-storage.example.com
# S3_REGION=your-region
# S3_BUCKET=your-staging-bucket
# S3_ACCESS_KEY_ID=STAGING_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=STAGING_SECRET_KEY
# Neon Object Storage requires path-style addressing. Change only for a
# different S3-compatible provider that requires virtual-hosted addressing.
# S3_FORCE_PATH_STYLE=true

# Optional parent passkeys; configure both values for the stable frontend origin.
# Password confirmation remains available when these are unset in production.
# WEB_AUTHN_RP_ID=your-app.example
# WEB_AUTHN_ORIGIN=https://your-app.example
