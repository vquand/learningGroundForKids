NODE_ENV=development
PORT=10000

# Runtime uses the pooled Neon connection. Migrations use the direct connection.
DATABASE_URL=postgresql://user:password@ep-example-pooler.neon.tech/app?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.neon.tech/app?sslmode=require

# Comma-separated allowlists. Keep production values in Render environment settings.
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_FORWARDED_HOSTS=localhost,localhost:5173
TRUST_PROXY_HEADERS=false
# Render provides RENDER_EXTERNAL_HOSTNAME automatically. Set it manually only
# when locally testing trusted forwarded-header behavior.
# RENDER_EXTERNAL_HOSTNAME=personal-learning-ground-api.onrender.com

SESSION_COOKIE_NAME=plg_session
SESSION_MAX_AGE_SECONDS=604800
ALLOW_REGISTRATION=false
# Optional recovery secret for root only (20–256 characters). Set a unique random
# value in Render's secret environment settings, never here or in frontend env.
# ROOT_FALLBACK_PASSWORD=
# One-time db:init-root credential output; absolute path OUTSIDE this checkout.
# ROOT_PASSWORD_FILE=/private/operator-directory/plg-root-initial-password.txt
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_KEYS=10000
# Only verified ingress proxy IPs/CIDRs belong here. Empty ignores X-Forwarded-For
# for authentication quotas and uses the Node socket peer. No catch-all ranges.
AUTH_TRUSTED_PROXY_CIDRS=
MAX_MEDIA_BYTES=26214400

# Leave all S3 settings unset to disable private media reads locally.
# S3_ENDPOINT=https://storage.example.com
# S3_REGION=auto
# S3_BUCKET=personal-learning-ground
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# Neon Object Storage requires true; keep this configurable for other S3 providers.
# S3_FORCE_PATH_STYLE=true

# Optional parent passkeys; configure both values for the stable frontend origin.
# Password confirmation remains available when these are unset in production.
# WEB_AUTHN_RP_ID=your-app.example
# WEB_AUTHN_ORIGIN=https://your-app.example

# Cosmetic town controls: honored only with NODE_ENV=test and an admin session.
# TOWN_ENVIRONMENT_PREVIEW_ENABLED=false

# Optional Google family registration/login. Configure all three on Render.
# Use a separate production OAuth client. Never put secrets in VITE_*.
# GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-production-client-secret
# GOOGLE_AUTH_ORIGIN=https://your-app.vercel.app
# Callback: https://your-app.vercel.app/api/v1/auth/google/callback
# ALLOW_REGISTRATION=true permits new families with either login method.

# Server-only weather. HTTPS host/path are code-allowlisted; no custom providers.
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
# Total forecast deadline, including streaming the body (1..10000 ms).
WEATHER_TIMEOUT_MS=4000

# Identify your deployment to MET Norway (site URL or contact), required by their terms.
# MET_USER_AGENT=YourApp/1.0 https://your-site.example
