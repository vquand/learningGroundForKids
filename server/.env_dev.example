# Copy to server/.env_dev for isolated local development. Never point these
# URLs at Neon or staging when running the local migration/seed commands.
NODE_ENV=development
PORT=10000
SERVER_HOST=127.0.0.1
DATABASE_URL=postgresql://plg_dev:plg_dev_local_only@127.0.0.1:55432/plg_dev
DATABASE_URL_UNPOOLED=postgresql://plg_dev:plg_dev_local_only@127.0.0.1:55432/plg_dev
TEST_DATABASE_URL=postgresql://plg_dev:plg_dev_local_only@127.0.0.1:55432/plg_test
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_FORWARDED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
ALLOW_REGISTRATION=false
# Configure privately before using root recovery; no development default secret.
# ROOT_FALLBACK_PASSWORD=
# For db:init-root:local, an unused absolute credential path outside the checkout.
# ROOT_PASSWORD_FILE=/private/operator-directory/plg-root-initial-password.txt

# Set these only in the ignored .env_dev before npm run db:bootstrap:local.
# BOOTSTRAP_EMAIL=dev@example.test
# BOOTSTRAP_NAME=Local Dev Admin
# BOOTSTRAP_PASSWORD=replace-with-a-unique-12-plus-character-password

# Leave S3 unset for local API testing without private media storage.
