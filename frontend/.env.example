# Active Vercel-to-Render rewrite origin. Configure this non-secret value in
# Vercel project settings as an HTTPS origin without a trailing slash. It is
# consumed by vercel.json and must not use a VITE_ prefix.
RENDER_API_ORIGIN=

# Local-only API origin used by `vite --mode vercel`. This is read by Vite's
# development server and is not included in the browser bundle.
LOCAL_API_ORIGIN=http://127.0.0.1:10000

# Transitional Sites development Worker proxy only.
# Leave empty to use http://127.0.0.1:8001; never set a production origin here.
VITE_API_ORIGIN=

# Browser-tab title, applied by Vite during development and builds.
# Unset or blank defaults to Playing Ground. Restart/rebuild after changes.
APP_NAME=Playing Ground

# Optional deployment-size reduction; ordinary/local builds retain all images.
# Enable only after artwork:verify succeeds against the selected private store.
ARTWORK_BLOB_ENABLED=false
# BLOB_STORE_ID=store_your_store_id
# ARTWORK_BLOB_VERIFIED_CATALOG=store_your_store_id:verified_catalog_sha256
# The function uses automatic Vercel OIDC; no Blob token is needed on Render.
# Match Render's cookie name only if it differs from the default.
# SESSION_COOKIE_NAME=plg_session

# Local dev mode: shows the "Dev info" toggle in Town test controls (IDs over buildings,
# rafts, animals and people; tap one to copy profileID/itemID/envSettings). Only works in
# Vite dev builds; leave unset everywhere else.
VITE_DEV_MODE=

# Optional Journey replay diagnostics. Visible only when Vite's development
# flag is true and VITE_JOURNEY_DIAGNOSTICS=true; leave unset by default.
VITE_JOURNEY_DIAGNOSTICS=
