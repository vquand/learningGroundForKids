# Staging worksheet for the Vercel frontend. Copy to .env.staging for private
# notes, then set RENDER_API_ORIGIN in Vercel Project Settings -> Environment
# Variables for the staging/preview deployment. Vercel's route config expands
# this value at request time; it is NOT a VITE_ browser-bundle variable.
RENDER_API_ORIGIN=https://your-staging-api.onrender.com

# Local Vite development only (vite --mode vercel); not needed on Vercel.
LOCAL_API_ORIGIN=http://127.0.0.1:10000

# Browser-tab title. Set in Vercel's build environment and rebuild to change it.
# Unset or blank defaults to Playing Ground.
APP_NAME=Playing Ground
